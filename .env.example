# ---- Deployment (used by compose.yaml) ----------------------------------
# your GitHub username, lowercase: the image is ghcr.io/<owner>/scaling-octo-carnival
GHCR_OWNER=fredcress
PORT=8420
# TrueNAS "apps" user; must be able to write DATA_PATH
PUID=568
PGID=568
DATA_PATH=/mnt/tank/apps/scaling-octo-carnival/data
# folder Syncthing fills with .fit files
FIT_PATH=/mnt/tank/syncthing/gadgetbridge
# optional: folder Syncthing fills with Gadgetbridge's database export
# (Gadgetbridge > Settings > Auto export); enables the Health tab
GADGETBRIDGE_PATH=
# fallback when a FIT file has no local time
TZ=Europe/Paris

# ---- Login ---------------------------------------------------------------
APP_USERNAME=admin
APP_PASSWORD=change-me
# Optional: generated and kept in DATA_PATH if empty
SECRET_KEY=
# Set to true when served over HTTPS (reverse proxy) so the cookie is HTTPS-only
SESSION_HTTPS_ONLY=false

# ---- Training model ------------------------------------------------------
MAX_HR=190
RESTING_HR=50
# male | female, used by the TRIMP formula
SEX=male
# seconds between folder scans
SCAN_INTERVAL=60

# ---- Coach note (optional, local LLM via Ollama) --------------------------
# e.g. http://192.168.1.50:11434 - Ollama must listen beyond localhost (OLLAMA_HOST=0.0.0.0)
OLLAMA_URL=
# exactly as `ollama list` shows it, e.g. qwen3:32b
OLLAMA_MODEL=

# ---- Strava (https://www.strava.com/settings/api) -------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# The URL you open the dashboard with; Strava redirects back to PUBLIC_URL/strava/callback.
# Its host must equal the "Authorization Callback Domain" of your Strava API app.
PUBLIC_URL=http://truenas.local:8420
# Optional: skip the in-app "Connect Strava" step by pasting a refresh token
# that already has the activity:write scope.
STRAVA_REFRESH_TOKEN=
